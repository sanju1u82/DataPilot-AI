# Optional backend configuration. Copy to .env and edit, or export directly.
#
# Leave everything unset for normal use. CORS already allows localhost:5173 plus
# any *.app.github.dev / *.gitpod.io host by regex, so a Codespace rebuild does
# not break the frontend the way a hardcoded origin does.

# Comma-separated exact origins, replacing the localhost defaults.
# Set to * to allow any origin (development only — this also disables credentials).
# DATAPILOT_ALLOWED_ORIGINS=http://localhost:5173,https://my-app.example.com

# Regex for origins whose hostname is generated per container.
# DATAPILOT_ALLOWED_ORIGIN_REGEX=https://.*\.app\.github\.dev

# Where uploaded CSVs and trained models are written.
# DATAPILOT_UPLOAD_DIR=./uploads

# Largest upload accepted, in megabytes.
# DATAPILOT_MAX_UPLOAD_MB=100
