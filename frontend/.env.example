# Optional frontend configuration. Copy to .env.local to override.
#
# Leave both unset for normal use. The app derives the backend URL from the page
# it is served from: on localhost it targets the same host on port 8000, and in
# Codespaces it swaps the forwarded port in the hostname (-5173 -> -8000). That
# keeps working after a Codespace rebuild, which a hardcoded URL does not.

# Point the frontend at a specific backend, overriding auto-detection.
# VITE_API_URL=http://localhost:8000

# Change only the backend port used by auto-detection.
# VITE_API_PORT=8000
